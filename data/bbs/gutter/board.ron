// THE NEON GUTTER: the default board, the LAN hangout (tier 1). The scene board: games, cracks,
// the starter tools and the first breakers (see docs/world.md). The basics: class breakers,
// small mods, the corp switchboard ranges. Dead Sector and CorpLink sell the step up.
// Every board is a folder under data/bbs/ with a board.ron and a splash.txt; see README "The BBS".
// Each run stocks `stock` random files per area.
// Text fields take Mystic-style pipe colour codes: |00-|15 foreground, |16-|23 background.
(
    name: "THE NEON GUTTER",
    sysop: "m0th",
    phone: "555-0199",
    baud: 14400,
    default: true,
    tiers: [1],
    call_cost: 0,   // a local number: calling it from home is free
    // No `look`: the Gutter is what every look field defaults to.
    bulletins: [
        (title: "READ THIS FIRST", body: [
            "|15Rules of the Gutter:",
            "|07 1. Don't leech. Upload or pay creds.",
            "|07 2. Don't post corp addresses. You know why.",
            "|07 3. If a sysop asks who you are, you're nobody.",
            "",
            "|08-- m0th",
        ]),
        (title: "BLACK ICE ADVISORY", body: [
            "|12!! |15Hydra builds spotted on corp backbones.",
            "|07Trace climbs fast. Bring a scrubber or bring a lawyer.",
            "|07Code gates fold to a decoder, sentries to a garrote.",
            "|07Keep notes. ICEDB.ZIP in WAREZ TOOLS remembers what you've fought.",
        ]),
        (title: "NEW IN THE FILE AREAS", body: [
            "|07Fresh TORCH build in icebreakers. Mil-spec, eats cycles.",
            "|07New deck? FREEWARE has your first breakers. On the house.",
            "|07Deck mods restocked. Want an overclock? Ask a corp.",
            "|07New area: OPTIMIZERS. Fragments raise a binary's opt level.",
            "|07Pro tip: |15hex <slot>|07 opens your warez. Mind the checksum.",
            "|07TEXTFILES has leaked phone ranges. New here? Start in G-FILES.",
            "|07QWKREAD.ZIP in WAREZ TOOLS: save the G-FILES, read them at home.",
            "|07GAMES area is up. Fresh cracks, cheap. Kids, keep it clean.",
        ]),
    ],
    users: [
        (handle: "m0th",      location: "Ninsei",       doing: "Sysop chat"),
        (handle: "c4se",      location: "Chiba",        doing: "Playing NIBBLER"),
        (handle: "ratz",      location: "Night City",   doing: "Reading bulletins"),
        (handle: "zero_kool", location: "Hamburg",      doing: "Door game: TradeWars"),
    ],
    areas: [
        (name: "ICEBREAKERS", stock: 3, files: [
            (file: "DECODR22.ZIP", item: Warez("decoder"),  price: 70,  desc: "Decoder v2.2 - code gate cracker"),
            (file: "GARROT11.ZIP", item: Warez("garrote"),  price: 70,  desc: "Garrote 1.1 - sentry killer"),
            (file: "CRWBAR30.ZIP", item: Warez("crowbar"),  price: 70,  desc: "Crowbar 3.0 - barrier fracter"),
        ]),
        (name: "DEFENSE & UTILITIES", stock: 2, files: [
            (file: "FIREWL.ZIP",   item: Warez("firewall"), price: 50,  desc: "Firewall - absorbs damage"),
            (file: "PATCH13.ZIP",  item: Warez("patch"),    price: 40,  desc: "Patch 1.3 - integrity repair"),
        ]),
        (name: "DECK MODS", stock: 2, files: [
            (file: "RAMSTIK.EXE",  item: Ram(1),            price: 90,  desc: "RAM stick. +1 GB"),
            (file: "HDDX.EXE",     item: Hdd(1),            price: 60,  desc: "Disk compressor. +1 slot"),
            (file: "NANOFIX.EXE",  item: Repair(8),         price: 60,  desc: "Nanite fix. +8 integrity"),
        ]),
        (name: "TEXTFILES", stock: 2, files: [
            (file: "PHONES.TXT",   item: Hint("brightwater"),      price: 30,  desc: "Brightwater's lines. Leaked by a temp"),
            (file: "YMT-NET.TXT",  item: Hint("yamatai"),          price: 40,  desc: "Yamatai dial-ins, partial list"),
            (file: "SAITO.TXT",    item: Hint("saito"),            price: 35,  desc: "Saito Pharma line dump"),
        ]),
        // Cracked games, signed by their crews (docs/world.md): the file names carry the tag.
        (name: "GAMES", stock: 2, files: [
            (file: "NIBB-2K4.ZIP", item: Game("nibbler"),   price: 15,  desc: "Nibbler. 2400 CLUB krak, it runs"),
            (file: "BLOX-PHS.ZIP", item: Game("blox"),      price: 30,  desc: "Blox 2.0. PHOSPHOR, the real one"),
            (file: "MINE-PHS.ZIP", item: Game("minefield"), price: 20,  desc: "Minefield 1.1. PHOSPHOR crack"),
        ]),
        (name: "OPTIMIZERS", stock: 1, files: [
            (file: "OPTFRAG.ZIP",  item: Fragment(1),       price: 70,  desc: "Optimizer fragment. +2 budget"),
        ]),
        // The starter kit: always here, free, yours for good. Nothing on the desktop says so.
        (name: "WAREZ TOOLS", stock: 4, always: true, files: [
            (file: "WARDIAL.ZIP",  item: Tool("wardial"),   price: 0,   desc: "m0th's demon dialer. Finds carriers"),
            (file: "HEXED.ZIP",    item: Tool("hexed"),     price: 0,   desc: "Hex editor. Patch your warez"),
            (file: "QWKREAD.ZIP",  item: Tool("qwkread"),   price: 0,   desc: "Offline mail reader. Read at home"),
            (file: "ICEDB.ZIP",    item: Tool("icedb"),     price: 0,   desc: "ICE bestiary. Know what you fight"),
        ]),
        // Your first breakers. A consumer deck ships with a shield and a repair kit; this is
        // where you get something that breaks ICE. The crews give their music disks away here
        // too, the way the scene always has (docs/world.md).
        (name: "FREEWARE", stock: 5, always: true, files: [
            (file: "ICEPICK.ZIP",  item: Warez("icepick"),  price: 0,   desc: "IcePick - chips at anything. Free"),
            (file: "DECODER.ZIP",  item: Warez("decoder"),  price: 0,   desc: "Decoder - code gates. Free"),
            (file: "NINSEI.MOD",   item: Tune("ninsei-nights"), price: 0, desc: "NiGHTMOTHS music disk. 3am shift"),
            (file: "CHROMA.MOD",   item: Tune("chroma"),        price: 0, desc: "PHOSPHOR. Fast, loud, perfect"),
            (file: "SILICON.MOD",  item: Tune("silicon-rain"),  price: 0, desc: "PHOSPHOR again. Wet and slow"),
        ]),
        (name: "G-FILES", stock: 4, always: true, files: [
            (file: "WARDIAL.TXT",  item: Text("primer"),    price: 0,   desc: "Wardialing for the clueless"),
            (file: "RANGES.TXT",   item: Text("ranges"),    price: 0,   desc: "Exchanges, prefixes, who owns what"),
            (file: "HEAT.TXT",     item: Text("heat"),      price: 0,   desc: "Why your number gets hot"),
            (file: "TELCO.TXT",    item: Text("telco"),     price: 0,   desc: "Ma Bell is listening"),
        ]),
    ],
    // Textfiles you read on the board (G-FILES). At most 16 lines of 72 columns each.
    texts: [
        (id: "primer", title: "WARDIALING FOR THE CLUELESS  by m0th", lines: [
            "|07Every network you'll ever run sits behind a phone number. Most of",
            "|07them answer with a voice, a fax or nothing. A few answer with a",
            "|15carrier|07: that whine is a modem, and a modem is a way in.",
            "",
            "|07A wardialer dials a block of numbers one after another and writes",
            "|07down every carrier. You don't do it by hand. Grab |15WARDIAL.ZIP|07 from",
            "|07WAREZ TOOLS, right here, free. Then at home, from your Shell:",
            "",
            "|11   ranges            |08what you know how to dial",
            "|11   wardial local     |08scan 100 numbers of the local exchange",
            "",
            "|07Carriers go in your phonebook. Dial one and you jack in.",
            "|07Each block costs a phone bill. Read RANGES.TXT before you burn creds.",
            "",
            "|08-- m0th",
        ]),
        (id: "ranges", title: "EXCHANGES & RANGES", lines: [
            "|07A range is the digits you know of a number. The local exchange is",
            "|07just |15555-|07: ten thousand numbers, mostly grandmothers. Carriers there",
            "|07are rare and small, LANs and the odd corp terminal.",
            "",
            "|07Corps buy their lines in blocks. Know |15555-7|07 and you're dialing",
            "|07a thousand numbers that are all Brightwater's. Know |15555-77|07 and",
            "|07it's a hundred, and those are the ones near the core.",
            "",
            "|07The more digits you know, the more carriers per block and the",
            "|07bigger the iron behind them. Also the pricier the bill.",
            "",
            "|07You learn ranges from leaked phone lists (|10[TXT]|07 in TEXTFILES),",
            "|07from data vaults on runs, and from people who owe you.",
        ]),
        (id: "heat", title: "HEAT", lines: [
            "|07Every time you run a number, its owners notice a little more.",
            "|07That's heat. A hot number has its ICE tuned up and its tracers",
            "|07awake: the same box gets harder every time you hit it.",
            "",
            "|07Heat cools while you leave a number alone. Run something else.",
            "|07Rotate. Wardial for fresh numbers instead of wearing one out.",
            "",
            "|07And watch who you work for. A client who sells you out hands",
            "|07your favourite number to the telco on the way.",
        ]),
        (id: "telco", title: "MA BELL IS LISTENING", lines: [
            "|07Not every line in a block is innocent. The telco plants watched",
            "|07numbers in the exchanges, and a wardialer that rings one trips",
            "|07a trap. The bigger the corp, the more traps in its ranges.",
            "",
            "|07A trap doesn't stop the scan. It marks you: your next run starts",
            "|07with the tracers already warm. Trip a few and you'll feel it.",
            "",
            "|07Scan, then run, and the heat from the traps is spent on that run.",
            "|07Scan all night and you'll jack in with the whole switchboard",
            "|07looking for you.",
            "",
            "|12Don't wardial from a line you care about.",
        ]),
    ],
)
