// DEAD SECTOR: an anarchy board on corp nets (tier 2), and anywhere a pirate runs it off a
// backbone. The hackers' and phreaks' board (see docs/world.md): hot warez, hot hardware, the
// first core ranges. No games, no kids. Red on black, box-drawn headers.
(
    name: "DEAD SECTOR",
    sysop: "d1rge",
    phone: "555-0666",
    baud: 2400,
    tiers: [2],
    call_cost: 5,  // phone bill to call it from home
    look: (
        software: "WWIV v4.24a  [unregistered]",
        header: Rule,
        frame: 4,
        bar: 0,
        key: 15,
        label: 12,
        dim: 8,
        text: 7,
        money: 14,
        ok: 10,
        warn: 12,
        aside: 6,
        prompt: ">>",
        handle: "ghost",
        menu: (
            files: ("Warez Vault", "cracked and clean. mostly."),
            jobs: ("Hit List", "somebody wants something dead"),
            bulletins: ("The Wall", "sysop rants. read them."),
            who: ("Who's Here", "nobody, officially"),
            goodbye: ("Hang Up", "drop carrier"),
        ),
        goodbye: "{board}: carrier dropped. We never met.",
        leet: true,
    ),
    bulletins: [
        (title: "HOUSE RULES", body: [
            "|151. No names. No faces. No real numbers.",
            "|152. Narcs get their handle posted on every board in the 555.",
            "|153. If you crash a corp net, you weren't here.",
            "",
            "|08-- d1rge",
        ]),
        (title: "WHY THE BREAKERS ARE CHEAP", body: [
            "|07Because they're hot. Every build here has been run before.",
            "|07Some of them twice. Patch them in a hex editor or eat the trace.",
            "|12Torch|07 copies are |12not|07 tested. Don't come crying.",
        ]),
        (title: "PHREAKING 101", body: [
            "|07Every corp leaks its prefix eventually. Somebody's temp,",
            "|07somebody's printer, somebody's kid with a modem.",
            "|07Buy a textfile, take the range home, wardial it. Tight ranges ring more.",
            "|07Core prefixes are worth it. The telco watches those.",
        ]),
    ],
    users: [
        (handle: "d1rge",     location: "???",          doing: "Watching you"),
        (handle: "lag",       location: "Sprawl",       doing: "Uploading (stalled)"),
        (handle: "acid_burn", location: "Chiba",        doing: "Reading The Wall"),
    ],
    areas: [
        (name: "0-DAY BREAKERS", stock: 3, files: [
            (file: "DCDR-HOT.ZIP", item: Warez("decoder"),  price: 60,  desc: "Decoder. Used. Still works"),
            (file: "GRRT-HOT.ZIP", item: Warez("garrote"),  price: 60,  desc: "Garrote, ripped from a corp drop"),
            (file: "CRWBR.ARJ",    item: Warez("crowbar"),  price: 60,  desc: "Crowbar. Smells like solder"),
            (file: "WYRM-X.ZIP",   item: Warez("wyrm"),     price: 150, desc: "Wyrm, modded. Hungry"),
        ]),
        (name: "SHELLS & SCRUBS", stock: 3, files: [
            (file: "FW-LITE.ZIP",  item: Warez("firewall"), price: 55,  desc: "Firewall, stripped down"),
            (file: "SCRB-666.ARJ", item: Warez("scrubber"), price: 110, desc: "Scrubber. Wipes logs, mostly"),
            (file: "LAGSPK2.ZIP",  item: Warez("lagspike"), price: 180, desc: "LagSpike 2. Freezes the box"),
            (file: "PATCHY.ZIP",   item: Warez("patch"),    price: 45,  desc: "Patch. Duct tape for decks"),
        ]),
        (name: "HOT HARDWARE", stock: 2, files: [
            (file: "RAM-HOT.ARJ",  item: Ram(2),            price: 200, desc: "RAM, fell off a truck. +2 GB"),
            (file: "DSK-HOT.ARJ",  item: Hdd(2),            price: 140, desc: "Drive, wiped. Mostly. +2 slots"),
            (file: "MEATFIX.ZIP",  item: Repair(10),        price: 80,  desc: "Back-alley repair. +10 integrity"),
        ]),
        (name: "PHREAK TEXTS", stock: 1, files: [
            (file: "KESTREL.TXT",  item: Hint("kestrel"),          price: 140, desc: "Kestrel exchange"),
            (file: "BW-CORE.TXT",  item: Hint("brightwater_core"), price: 240, desc: "Brightwater core prefix. Fresh"),
            (file: "SAITO-LB.TXT", item: Hint("saito_core"),       price: 240, desc: "Saito lab lines"),
        ]),
        // The terminal the scene runs: what CarrierTerm won't tell you about a number.
        (name: "COMMS", stock: 1, always: true, files: [
            (file: "NIGHTCOM.ZIP", item: Tool("nightcomm"), price: 120, desc: "NiGHTCOMM 3.1. Know your lines"),
        ]),
        (name: "WAREZ TOOLS", stock: 1, files: [
            (file: "FRAG-HOT.ZIP", item: Fragment(1),       price: 90,  desc: "Optimizer fragment, cracked"),
            (file: "FRAG2-X.ZIP",  item: Fragment(2),       price: 170, desc: "Fragments x2, no serials"),
        ]),
    ],
)
