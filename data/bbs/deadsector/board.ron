// DEAD SECTOR: an anarchy board on LANs and the nastiest megacorp nets. Cheap breakers,
// phreak textfiles, no deck-mod shop. Red on black, box-drawn headers.
(
    name: "DEAD SECTOR",
    sysop: "d1rge",
    phone: "555-0666",
    baud: 2400,
    tiers: [1, 3],
    call_cost: 5,  // phone bill to call it from home
    look: (
        software: "WWIV v4.24a  [unregistered]",
        header: Rule,
        frame: 4,
        bar: 0,
        key: 15,
        label: 12,
        dim: 8,
        text: 7,
        money: 14,
        ok: 10,
        warn: 12,
        aside: 6,
        prompt: ">>",
        handle: "ghost",
        menu: (
            files: ("Warez Vault", "cracked and clean. mostly."),
            jobs: ("Hit List", "somebody wants something dead"),
            bulletins: ("The Wall", "sysop rants. read them."),
            who: ("Who's Here", "nobody, officially"),
            goodbye: ("Hang Up", "drop carrier"),
        ),
        goodbye: "{board}: carrier dropped. We never met.",
        leet: true,
    ),
    bulletins: [
        (title: "HOUSE RULES", body: [
            "|151. No names. No faces. No real numbers.",
            "|152. Narcs get their handle posted on every board in the 555.",
            "|153. If you crash a corp net, you weren't here.",
            "",
            "|08-- d1rge",
        ]),
        (title: "WHY THE BREAKERS ARE CHEAP", body: [
            "|07Because they're hot. Every build here has been run before.",
            "|07Some of them twice. Patch them in a hex editor or eat the trace.",
            "|12Torch|07 copies are |12not|07 tested. Don't come crying.",
        ]),
        (title: "PHREAKING 101", body: [
            "|07Every corp leaks its prefix eventually. Somebody's temp,",
            "|07somebody's printer, somebody's kid with a modem.",
            "|07Buy a textfile, take the range home, wardial it. Tight ranges ring more.",
            "|07Core prefixes are worth it. The telco watches those.",
        ]),
    ],
    users: [
        (handle: "d1rge",     location: "???",          doing: "Watching you"),
        (handle: "lag",       location: "Sprawl",       doing: "Uploading (stalled)"),
        (handle: "acid_burn", location: "Chiba",        doing: "Reading The Wall"),
    ],
    areas: [
        (name: "0-DAY BREAKERS", stock: 4, files: [
            (file: "DCDR-HOT.ZIP", item: Warez("decoder"),  price: 55,  desc: "Decoder. Used. Still works"),
            (file: "GRRT-HOT.ZIP", item: Warez("garrote"),  price: 55,  desc: "Garrote, ripped from a corp drop"),
            (file: "CRWBR.ARJ",    item: Warez("crowbar"),  price: 55,  desc: "Crowbar. Smells like solder"),
            (file: "WYRM-X.ZIP",   item: Warez("wyrm"),     price: 110, desc: "Wyrm, modded. Hungry"),
            (file: "TORCH-B.LZH",  item: Warez("torch"),    price: 210, desc: "TORCH beta. [UNTESTED]"),
        ]),
        (name: "SHELLS & SCRUBS", stock: 3, files: [
            (file: "FW-LITE.ZIP",  item: Warez("firewall"), price: 45,  desc: "Firewall, stripped down"),
            (file: "SCRB-666.ARJ", item: Warez("scrubber"), price: 75,  desc: "Scrubber. Wipes logs, mostly"),
            (file: "LAGSPK2.ZIP",  item: Warez("lagspike"), price: 130, desc: "LagSpike 2. Freezes the box"),
            (file: "PATCHY.ZIP",   item: Warez("patch"),    price: 35,  desc: "Patch. Duct tape for decks"),
        ]),
        (name: "PHREAK TEXTS", stock: 3, files: [
            (file: "YMT-RND.TXT",  item: Hint("yamatai_core"),    price: 85,  desc: "Yamatai R&D prefix. Hot"),
            (file: "SAITO-LB.TXT", item: Hint("saito_core"),      price: 80,  desc: "Saito lab lines"),
            (file: "KSTRL-BS.TXT", item: Hint("kestrel_core"),    price: 120, desc: "Kestrel black site. Don't."),
            (file: "BW-LINES.TXT", item: Hint("brightwater"),     price: 25,  desc: "Brightwater lines, old dump"),
            (file: "KESTREL.TXT",  item: Hint("kestrel"),         price: 60,  desc: "Kestrel exchange"),
        ]),
    ],
)
