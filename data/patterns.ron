// 1-bit fill patterns, after MacPaint's palette. The Sense/Net deck's parts (the Liza desktop,
// the Paint map, the Stack chrome) shade with these, never with colour or gradients.
//
// Each pattern is an 8x8 tile, one char per pixel:
//   #  ink     .  paper
// A pattern always draws in two theme roles (ink and paper), so it works in every theme and on
// mono tubes; the app draws it pixel-aligned at a whole-number scale.
// `fallback` is a coarser pattern to use where this one shimmers through the CRT (moiré).
[
    (id: "p12", label: "12.5%", rows: [
        "#...#...",
        "........",
        "..#...#.",
        "........",
        "#...#...",
        "........",
        "..#...#.",
        "........",
    ]),
    (id: "p25", label: "25%", rows: [
        "#.#.#.#.",
        "........",
        ".#.#.#.#",
        "........",
        "#.#.#.#.",
        "........",
        ".#.#.#.#",
        "........",
    ]),
    (id: "p50", label: "50% checker", fallback: Some("p25"), rows: [
        "#.#.#.#.",
        ".#.#.#.#",
        "#.#.#.#.",
        ".#.#.#.#",
        "#.#.#.#.",
        ".#.#.#.#",
        "#.#.#.#.",
        ".#.#.#.#",
    ]),
    (id: "p75", label: "75%", rows: [
        ".#.#.#.#",
        "########",
        "#.#.#.#.",
        "########",
        ".#.#.#.#",
        "########",
        "#.#.#.#.",
        "########",
    ]),
    (id: "lines", label: "lines", rows: [
        "########",
        "........",
        "........",
        "........",
        "########",
        "........",
        "........",
        "........",
    ]),
    (id: "columns", label: "columns", rows: [
        "#...#...",
        "#...#...",
        "#...#...",
        "#...#...",
        "#...#...",
        "#...#...",
        "#...#...",
        "#...#...",
    ]),
    (id: "diagonal", label: "diagonal", rows: [
        "...#...#",
        "..#...#.",
        ".#...#..",
        "#...#...",
        "...#...#",
        "..#...#.",
        ".#...#..",
        "#...#...",
    ]),
    (id: "crosshatch", label: "crosshatch", rows: [
        "#..##..#",
        ".##..##.",
        ".##..##.",
        "#..##..#",
        "#..##..#",
        ".##..##.",
        ".##..##.",
        "#..##..#",
    ]),
    (id: "bricks", label: "bricks", rows: [
        "########",
        "#.......",
        "#.......",
        "#.......",
        "########",
        "....#...",
        "....#...",
        "....#...",
    ]),
    (id: "dots", label: "dots", rows: [
        "........",
        ".##.....",
        ".##.....",
        "........",
        "........",
        ".....##.",
        ".....##.",
        "........",
    ]),
    (id: "pinstripes", label: "pinstripes", fallback: Some("lines"), rows: [
        "########",
        "........",
        "########",
        "........",
        "########",
        "........",
        "########",
        "........",
    ]),
]
