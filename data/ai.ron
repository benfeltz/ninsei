// The nets' AIs. Every network runs one: a product its corp bought, which drafts the net's ICE
// for the humans to sign off. It isn't up when you jack in; it wakes when trace reaches the
// net's threshold (`hub/networks.ron`) and fights through the same loop as ICE.
//
// models:   what a corp buys: the company that sells it, the product's name, its class, its
//           machine (cpu, ram, hdd, as an ICE row's in `ice.ron`) and its vocabulary (`verbs`,
//           with a range for every verb that takes a number). SEGFAULT is an AI's verb: no
//           ordinary ICE has it. Every version of a model fits its machine.
// versions: a model's programs, one per version, written by hand: `version` as the product
//           numbers it, the `strength` it fights at (the net's ICE bonus and heat add to it, as
//           they do to ICE), and its `program` in the fight's BASIC. Its header is a REM.
// runs:     which version a net runs: (tier, heat, model, version). A net takes its tier's row
//           with the highest heat at or under its own; every tier has a row at heat 0.
(
    models: [
        (id: "watchman", company: "Maas-Neotek", name: "WATCHMAN", class: CodeGate,
            cpu: 1, ram: 2, hdd: 10,
            verbs: [Attack, Trace, Segfault],
            ranges: [(Attack, 3, 7), (Trace, 3, 8)]),
        (id: "sentinel", company: "Maas-Neotek", name: "SENTINEL", class: Sentry,
            cpu: 2, ram: 3, hdd: 14,
            verbs: [Attack, Trace, Spoof, Segfault],
            ranges: [(Attack, 4, 9), (Trace, 3, 8), (Spoof, 1, 3)]),
        (id: "warden", company: "Hosaka", name: "WARDEN", class: Barrier,
            cpu: 2, ram: 4, hdd: 18,
            verbs: [Attack, Trace, Fortify, Spoof, Segfault],
            ranges: [(Attack, 5, 10), (Trace, 4, 9), (Fortify, 3, 6), (Spoof, 1, 3)]),
    ],
    versions: [
        (model: "watchman", version: "1.2", strength: 22, program: "
            10 REM MAAS-NEOTEK WATCHMAN 1.2
            20 IF TARGET RAN patch
            30 SEGFAULT
            40 IF TARGET SHIELD > 0
            50 TRACE 6
            60 ATTACK 5
            70 ATTACK 4"),
        (model: "watchman", version: "1.4", strength: 25, program: "
            10 REM MAAS-NEOTEK WATCHMAN 1.4
            20 IF TARGET RAN patch
            30 SEGFAULT
            40 IF TARGET SHIELD > 0
            50 TRACE 7
            60 IF TARGET INTEG < 8
            70 ATTACK 7
            80 ATTACK 5"),
        (model: "sentinel", version: "3.0", strength: 26, program: "
            10 REM MAAS-NEOTEK SENTINEL 3.0
            20 IF TARGET SHIELD > 0
            30 SPOOF 2
            40 IF TARGET RAN firewall
            50 SEGFAULT
            60 ATTACK 6
            70 TRACE 4
            80 ATTACK 5"),
        (model: "sentinel", version: "3.2", strength: 29, program: "
            10 REM MAAS-NEOTEK SENTINEL 3.2
            20 IF TARGET SHIELD > 0
            30 SPOOF 2
            40 IF TARGET RAN firewall
            50 SEGFAULT
            60 IF TARGET INTEG < 10
            70 ATTACK 9
            80 ATTACK 6
            90 TRACE 5"),
        (model: "warden", version: "4.2", strength: 30, program: "
            10 REM HOSAKA WARDEN 4.2
            20 IF TARGET RAN icepick
            30 SEGFAULT
            40 IF SELF STR < 20
            50 FORTIFY 5
            60 IF TARGET SHIELD > 0
            70 TRACE 6
            80 ATTACK 7
            90 ATTACK 6"),
        (model: "warden", version: "4.5", strength: 34, program: "
            10 REM HOSAKA WARDEN 4.5
            20 IF TARGET RAN icepick
            30 SEGFAULT
            40 IF TARGET RAN patch
            50 SEGFAULT
            60 IF SELF STR < 24
            70 FORTIFY 6
            80 IF TARGET SHIELD > 0
            90 TRACE 7
            100 IF TARGET INTEG < 10
            110 ATTACK 10
            120 ATTACK 7"),
    ],
    runs: [
        (tier: 1, heat: 0, model: "watchman", version: "1.2"),
        (tier: 1, heat: 3, model: "watchman", version: "1.4"),
        (tier: 2, heat: 0, model: "sentinel", version: "3.0"),
        (tier: 2, heat: 3, model: "sentinel", version: "3.2"),
        (tier: 3, heat: 0, model: "warden",   version: "4.2"),
        (tier: 3, heat: 3, model: "warden",   version: "4.5"),
    ],
)
