// How the network map draws each kind of node.
//
// mesh:    the wireframe shape in the isometric view.
//          Cube, Ring, Ico, Spikes, Drum, Octa, Pyramid, Nested, Pad, Portal
// symbol:  the drafting symbol on the flat draft view.
//          Hatch (section hatching), Valve (circle and cross), Eye (circle and pupil),
//          Crosshatch (dense hatching, double outline), Column (square and X), Hex,
//          Flag (triangle), Nested (square in a square), Inlet (arrow in), Door (door swing)
// tag:     the short label under the node.
// paint:   how the Paint view (the Sense/Net deck) fills the node: a pattern from patterns.ron,
//          or `paper` (blank, the tag written inside) or `solid` (all ink).
//
// Every node kind (ICE by class) needs exactly one entry; `Data::validate` checks.
[
    (node: Entry,    mesh: Pad,     symbol: Inlet,      tag: "ENTRY",     paint: "paper"),
    (node: Barrier,  mesh: Cube,    symbol: Hatch,      tag: "BARRIER",   paint: "bricks"),
    (node: CodeGate, mesh: Ring,    symbol: Valve,      tag: "CODE GATE", paint: "crosshatch"),
    (node: Sentry,   mesh: Ico,     symbol: Eye,        tag: "SENTRY",    paint: "dots"),
    (node: BlackIce, mesh: Spikes,  symbol: Crosshatch, tag: "BLACK ICE", paint: "solid"),
    (node: Vault,    mesh: Drum,    symbol: Column,     tag: "VAULT",     paint: "lines"),
    (node: Bbs,      mesh: Octa,    symbol: Hex,        tag: "BBS",       paint: "paper"),
    (node: Contact,  mesh: Pyramid, symbol: Flag,       tag: "MSG",       paint: "paper"),
    (node: Subnet,   mesh: Nested,  symbol: Nested,     tag: "SUBNET",    paint: "columns"),
    (node: Exit,     mesh: Portal,  symbol: Door,       tag: "EXIT",      paint: "paper"),
]
