// Sound effects: what plays for each cue a run emits. Synthesized, never sampled, like the modem.
//
// Each cue is a few notes played one after another:
//   wave   Square | Saw | Triangle | Sine | Noise
//   from   starting pitch in Hz (ignored for Noise, which uses it as a brightness 0-8000)
//   to     ending pitch: the note sweeps from `from` to `to`
//   ms     length in milliseconds
//   vol    0.0-1.0 (all cues are mixed quietly under the modem)
// Every cue needs an entry; `Data::validate` checks. Keep them short: under half a second.
[
    (cue: Hop,      notes: [(wave: Square,   from: 660,  to: 880,  ms: 30,  vol: 0.18)]),
    (cue: IceRez,   notes: [(wave: Saw,      from: 120,  to: 240,  ms: 120, vol: 0.30),
                            (wave: Square,   from: 240,  to: 240,  ms: 60,  vol: 0.22)]),
    (cue: Hit,      notes: [(wave: Square,   from: 1200, to: 300,  ms: 70,  vol: 0.30)]),
    (cue: Shield,   notes: [(wave: Triangle, from: 400,  to: 800,  ms: 90,  vol: 0.30)]),
    (cue: Heal,     notes: [(wave: Sine,     from: 520,  to: 520,  ms: 60,  vol: 0.30),
                            (wave: Sine,     from: 780,  to: 780,  ms: 90,  vol: 0.30)]),
    (cue: Block,    notes: [(wave: Square,   from: 220,  to: 180,  ms: 50,  vol: 0.22),
                            (wave: Noise,    from: 2500, to: 2500, ms: 40,  vol: 0.10)]),
    (cue: Damage,   notes: [(wave: Noise,    from: 1800, to: 1800, ms: 120, vol: 0.35),
                            (wave: Saw,      from: 160,  to: 70,   ms: 140, vol: 0.30)]),
    (cue: Derez,    notes: [(wave: Square,   from: 880,  to: 880,  ms: 50,  vol: 0.26),
                            (wave: Square,   from: 660,  to: 660,  ms: 50,  vol: 0.26),
                            (wave: Square,   from: 440,  to: 110,  ms: 160, vol: 0.30),
                            (wave: Noise,    from: 4000, to: 4000, ms: 90,  vol: 0.15)]),
    (cue: Loot,     notes: [(wave: Square,   from: 988,  to: 988,  ms: 45,  vol: 0.22),
                            (wave: Square,   from: 1319, to: 1319, ms: 90,  vol: 0.22)]),
    (cue: Download, notes: [(wave: Triangle, from: 600,  to: 1200, ms: 160, vol: 0.22),
                            (wave: Square,   from: 1200, to: 1200, ms: 40,  vol: 0.18)]),
    (cue: TraceUp,  notes: [(wave: Square,   from: 1500, to: 1500, ms: 60,  vol: 0.20),
                            (wave: Sine,     from: 0,    to: 0,    ms: 40,  vol: 0.0),
                            (wave: Square,   from: 1500, to: 1500, ms: 60,  vol: 0.20)]),
    (cue: Encounter,notes: [(wave: Sine,     from: 880,  to: 880,  ms: 80,  vol: 0.25),
                            (wave: Sine,     from: 1175, to: 1175, ms: 120, vol: 0.25)]),
    (cue: Flatline, notes: [(wave: Saw,      from: 440,  to: 55,   ms: 420, vol: 0.32),
                            (wave: Sine,     from: 1000, to: 1000, ms: 350, vol: 0.20)]),
    (cue: JackOut,  notes: [(wave: Square,   from: 523,  to: 523,  ms: 70,  vol: 0.22),
                            (wave: Square,   from: 659,  to: 659,  ms: 70,  vol: 0.22),
                            (wave: Square,   from: 784,  to: 784,  ms: 70,  vol: 0.22),
                            (wave: Square,   from: 1047, to: 1047, ms: 160, vol: 0.22)]),
]
