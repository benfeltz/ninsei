// RIG deck shop. Each purchase of an upgrade adds `step` and costs more than the last:
// cost(level) = base_cost grown by growth_pct per level already owned. `max` caps the level.
[
    (kind: Ram,       label: "RAM",   unit: "GB",    step: 1, max: 6, base_cost: 90,  growth_pct: 45, blurb: "More programs loaded at once."),
    (kind: Cpu,       label: "CPU",   unit: "cyc",   step: 1, max: 3, base_cost: 220, growth_pct: 70, blurb: "One more action every turn."),
    (kind: Hdd,       label: "HDD",   unit: "slots", step: 1, max: 6, base_cost: 60,  growth_pct: 40, blurb: "Carry more programs into a run."),
    (kind: Integrity, label: "INTEG", unit: "",      step: 3, max: 6, base_cost: 70,  growth_pct: 45, blurb: "Take more hits before you flatline."),
    (kind: Stash,     label: "STASH", unit: "slots", step: 1, max: 4, base_cost: 120, growth_pct: 60, blurb: "Keep more programs between runs."),
]
