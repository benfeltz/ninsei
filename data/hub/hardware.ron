         ]),
        (id: "onosendai5", art: Some("deck-onosendai"), name: "Cyberspace V", maker: "Ono-Sendai", price: 250,
         blurb: "The cowboy's first real deck. Same matrix, same grid, a smaller board inside the case.",
         stats: [(line: Cpu, base: 3, max: 3), (line: Ram, base: 6, max: 8),
                 (line: Hdd, base: 6, max: 8), (line: Integrity, base: 18, max: 21)],
