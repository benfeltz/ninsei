// Hardware you own: monitors and decks. Bought in RIG (HARDWARE) with banked credits.
//
// monitors: each plugs a CRT display preset (data/displays.ron) into your rig.
//   display   the preset it shows
//   colour    false: a mono tube, locked to its display's theme (an amber screen only shows amber)
//             true:  a colour tube, any theme
//   starter   exactly one monitor is yours from the start
//
// decks: the cyberdeck you run with: its look and feel, plus the chassis.
//   stats     per RIG line (Cpu, Ram, Hdd, Integrity): what the deck ships with (`base`) and the
//             most that line can reach on it (`max`), counting RIG levels, deck mods bought on
//             a board and loot. A line not listed starts at its tuning.rs constant with no
//             ceiling; every deck lists the same lines. Stash is home storage, never a deck's.
//             These rows are the only numbers on hardware that change play.
//   firmware  one or more UX versions, each built from named parts:
//               map:     Iso (wireframes over a grid) | Draft (a flat technical drawing) |
//                        Paint (a 1-bit picture, nodes filled with patterns)
//               chrome:  Classic | Btop | Suite | Stack (how the run screen is dressed)
//               desktop: Workbench | Tiling | Liza (the overworld's look)
//               sounds:  a sound pack in data/sounds/ ("ono", "hosaka")
//               panes:   secondary panes that come free with it (ids in hub/panes.ron)
//             The first is what the deck ships with. A new UX version is a new entry here.
//   starter   exactly one deck is yours from the start
//   art       its picture in CPU Shopper's ads: a 1-bit grid in data/art/<id>.txt (`#` ink,
//             `.` paper, up to 128x96). Replace the picture by overwriting that file.
(
    monitors: [
        (id: "white",  name: "Personal Display 9\"", maker: "Sense/Net", price: 0, display: "paperwhite", colour: false, starter: true,
         blurb: "A small, sharp black-and-white tube. Everybody's first screen."),
        (id: "amber",  name: "Amber Terminal",    maker: "Zenith",    price: 90,  display: "amber",  colour: false,
         blurb: "Long-persistence P3 amber. Easy on the eyes at 4am."),
        (id: "green",  name: "Green Phosphor",    maker: "Hercules",  price: 140, display: "green",  colour: false,
         blurb: "P1 green, flat glass. The classic terminal glow."),
        (id: "apple2", name: "Monitor II",        maker: "Apple",     price: 220, display: "apple2", colour: true,
         blurb: "Bright and curved, with a shine you can see your face in."),
        (id: "c64",    name: "1702",              maker: "Commodore", price: 280, display: "c64",    colour: true,
         blurb: "Fat bezel, soft scanlines, colour that bleeds a little."),
        (id: "vga",    name: "8513 VGA",          maker: "IBM",       price: 420, display: "vga",    colour: true,
         blurb: "Crisp 640x480. Business-grade colour for any theme."),
    ],
    // Two tiers of machine: the Sense/Net is the starter and caps low; the Ono-Sendai and the
    // Hosaka are the real deck, at one ceiling, in two shapes (the Ono ships with more CPU, the
    // Hosaka with more RAM and HDD). Climbing is one purchase, then RIG.
    decks: [
        (id: "sensenet", art: Some("deck-sensenet"), name: "Personal Deck", maker: "Sense/Net", price: 0, starter: true,
         blurb: "Everybody's first deck. Friendly, tidy, 1-bit: the net as a stack of cards you page through.",
         stats: [(line: Cpu, base: 3, max: 3), (line: Ram, base: 6, max: 8),
                 (line: Hdd, base: 6, max: 8), (line: Integrity, base: 18, max: 21)],
         firmware: [
            (id: "1.0", label: "Liza 1.0", map: Paint, chrome: Stack, desktop: Liza, sounds: "sensenet"),
         ]),
        (id: "onosendai", art: Some("deck-onosendai"), name: "Cyberspace VII", maker: "Ono-Sendai", price: 2500,
         blurb: "The cowboy's deck. Jacks you straight into the matrix: wireframes over a glowing grid.",
         stats: [(line: Cpu, base: 4, max: 6), (line: Ram, base: 6, max: 12),
                 (line: Hdd, base: 6, max: 12), (line: Integrity, base: 18, max: 36)],
         firmware: [
            (id: "7.0", label: "Cyberspace 7.0", map: Iso, chrome: Btop, desktop: Tiling, sounds: "ono", panes: ["net"]),
            (id: "6.2", label: "Cyberspace 6.2 (classic panes)", map: Iso, chrome: Classic, desktop: Workbench, sounds: "ono"),
         ]),
        (id: "hosaka", art: Some("deck-hosaka"), name: "Executive 4", maker: "Hosaka", price: 2500,
         blurb: "A corporate workstation. Sees the net as a plan: every node drafted, dimensioned and filed.",
         stats: [(line: Cpu, base: 3, max: 6), (line: Ram, base: 7, max: 12),
                 (line: Hdd, base: 7, max: 12), (line: Integrity, base: 18, max: 36)],
         firmware: [
            (id: "4.0", label: "PlanView 4.0", map: Draft, chrome: Suite, desktop: Workbench, sounds: "hosaka"),
         ]),
    ],
)
