    (id: "blox", name: "Blox", blurb: "Falling blocks: turn them, drop them, clear the lines.",
     publisher: "papertiger", version: "2.0", engine: Blox, cols: 10, rows: 20, tick_ms: 50,
     crack: "blox-crack", splash: "blox-splash", shop: Some((price: 60)),
     icon: [
         "................",
         "......kkkk......",
         "......kook......",
         "......kook......",
         "......kkkkkkkk..",
         "......kookbbbk..",
         "......kookbbbk..",
         "..kkkkkkkkkkkk..",
         "..kwwkwwkbbkbk..",
         "..kwwkwwkbbkbk..",
         "..kkkkkkkkkkkk..",
         "..kookookookok..",
