// Networks you can dial from CarrierTerm.
//
// tiers:     size, ICE strength and pay for each tier; `traits` is how many traits it rolls (min, max);
//            `subnets` is how many subnet nodes it has (doors to a small private network and back).
//            `choke` puts a one-node guarded layer every that many layers (0: none; a trait's Shape
//            replaces it); `black` adds to the black ICE weight; `trace_pct` is the tier's trace rate
//            (traits and heat stack on it).
// traits:    what makes a network play differently. Effects:
//              IceClass(Barrier | CodeGate | Sentry)  most ICE is this class
//              BlackIce(n)   +n weight for black ICE nodes
//              NoBbs         no BBS on this network
//              Trace(pct)    trace gain is pct% of normal
//              Chatty(n)     +n weight for MSG nodes
//              VaultRich(n)  +n weight for data vaults
//              Pay(pct)      credits are pct% of normal (stacks with the tier)
//              Shape(min_width, max_width, links, choke)
//                            topology: middle layers are min..=max nodes wide, `links`% chance of
//                            an extra cross link per node, every `choke`th layer is one guarded
//                            node (0 = none; never the BBS layer). Default is (2, 4, 35, 0).
//              Subnets(n)    +n subnet nodes
//              Board(id)     this network's BBS is data/bbs/<id>/ (otherwise one of the boards
//                            for its tier, picked by the phone number)
//            Each trait also has a `finding` and a `severity` (Info, Low, Medium, High): how
//            Tiger Team Pro's assessment words it, in the security team's voice.
// companies: names and lines of business for phonebook entries.
(
    tiers: [
        (tier: 1, label: "LAN", mid_layers: 4, ice_bonus: 0, pay_pct: 80, traits: (0, 1), subnets: 0, choke: 0, black: 0, trace_pct: 100),
        (tier: 2, label: "CORP", mid_layers: 5, ice_bonus: 6, pay_pct: 130, traits: (1, 2), subnets: 1, choke: 3, black: 8, trace_pct: 110),
        (tier: 3, label: "MEGACORP", mid_layers: 6, ice_bonus: 9, pay_pct: 200, traits: (2, 2), subnets: 1, choke: 3, black: 16, trace_pct: 115),
    ],
    traits: [
        (id: "sentry_heavy",   label: "sentry-heavy",    blurb: "Sentries patrol everything. Bring a garrote.",   effect: IceClass(Sentry), finding: "Sentry countermeasures patrol every segment.", severity: High),
        (id: "barrier_heavy",  label: "barrier-heavy",   blurb: "Walls on walls. Bring a crowbar.",              effect: IceClass(Barrier), finding: "Layered barriers on every segment.", severity: Medium),
        (id: "codegate_heavy", label: "code-gate-heavy", blurb: "Everything's behind a gate. Bring a decoder.",  effect: IceClass(CodeGate), finding: "Access is controlled by code gates throughout.", severity: Medium),
        (id: "black_ice",      label: "black ice",       blurb: "Someone here plays rough.",                     effect: BlackIce(22), finding: "Lethal countermeasures (black ICE) are deployed.", severity: High),
        (id: "no_bbs",         label: "no BBS",          blurb: "No board on this net. No rest stop.",           effect: NoBbs, finding: "No bulletin board on site.", severity: Info),
        (id: "graveyard",      label: "graveyard shift", blurb: "Skeleton crew watching. Trace -25%.",           effect: Trace(75), finding: "Reduced overnight staffing: trace response 75%.", severity: Low),
        (id: "night_shift",    label: "night shift",     blurb: "Wide awake and bored. Trace +25%.",             effect: Trace(125), finding: "Full overnight staffing: trace response 125%.", severity: Medium),
        (id: "chatty",         label: "chatty",          blurb: "Lots of people on the line.",                   effect: Chatty(20), finding: "Heavy user traffic on the line.", severity: Info),
        (id: "vault_rich",     label: "vault-rich",      blurb: "Data everywhere, lightly guarded.",             effect: VaultRich(20), finding: "Large data stores with light protection.", severity: Info),
        (id: "mesh",           label: "mesh",            blurb: "Wide open, routes everywhere. Pick your fights.",       effect: Shape((min_width: 3, max_width: 5, links: 75, choke: 0)), finding: "Flat, heavily meshed topology.", severity: Low),
        (id: "chokepoints",    label: "chokepoints",     blurb: "Every other hop funnels through one guarded box.",      effect: Shape((min_width: 2, max_width: 4, links: 35, choke: 2)), finding: "Every other layer funnels through one guarded node.", severity: Medium),
        (id: "daisy_chain",    label: "daisy chain",     blurb: "Long thin lines. No way around anything.",              effect: Shape((min_width: 1, max_width: 2, links: 15, choke: 0)), finding: "Linear topology with no alternate routes.", severity: Medium),
        (id: "segmented",      label: "segmented",       blurb: "Private segments behind every door. Vaults inside.",    effect: Subnets(1), finding: "Private segments behind subnet doors.", severity: Low),
        (id: "skint",          label: "skint",           blurb: "Nothing worth stealing. Credits -30%.",         effect: Pay(70), finding: "Low-value assets: payouts 70%.", severity: Info),
        (id: "pirate_board",   label: "pirate board",    blurb: "Someone's running DEAD SECTOR off their backbone.", effect: Board("deadsector"), finding: "An unlicensed bulletin board runs on the backbone.", severity: Info),
    ],
    companies: [
        (name: "Ono Drycleaning",      business: "laundry"),
        (name: "Kowloon Noodle Co.",   business: "food"),
        (name: "Brightwater Mutual",   business: "insurance"),
        (name: "Yamatai Dynamics",     business: "robotics"),
        (name: "Lazarus Clinic",       business: "medical"),
        (name: "Chiba Freight Co-op",  business: "logistics"),
        (name: "Hollow Pines Credit",  business: "banking"),
        (name: "Saito Pharmaceutical", business: "pharma"),
        (name: "Glasswing Media",      business: "news"),
        (name: "Redline Couriers",     business: "delivery"),
        (name: "Mirrorshade Optics",   business: "optics"),
        (name: "Tessier Holdings",     business: "real estate"),
        (name: "Northgate Penal",      business: "prisons"),
        (name: "Kestrel Aerospace",    business: "defense"),
        (name: "Velvet Static",        business: "nightclub"),
        (name: "Ironbark Utilities",   business: "power grid"),
    ],
)
