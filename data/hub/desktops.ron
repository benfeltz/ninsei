// Desktop add-ons: small upgrades for a desktop, bought in RIG (HARDWARE) with banked credits.
// Each belongs to one desktop and does one thing:
//   Workspaces(n)  +n workspaces on the tiling desktop (it starts with 3)
//   Fuzzy          the launcher matches loosely and runs Shell commands too
//   Stats          a run-record widget on the tiling desktop's bar
//   Clock          an uptime clock and the bank on the Workbench's title bar
//   Pattern        a dithered backdrop for the Workbench; a different desktop pattern on Liza
//   Calculator     a desk accessory on Liza: the bank, the next RIG upgrade, your numbers' heat
//   MultiFinder    Liza keeps every window open (it starts with three at once)
//   Clock          on Liza: the time in the menu bar
// A new add-on for an existing effect is just an entry here; a new kind of effect is a name in
// `desktop::AddonEffect` plus the desktop that draws it.
[
    (id: "workspaces", desktop: Tiling,    name: "Workspace pack", price: 90,
     blurb: "Two more workspaces. Spread out.",                       effect: Workspaces(2)),
    (id: "fuzzy",      desktop: Tiling,    name: "fzf launcher",   price: 120,
     blurb: "The launcher matches loosely and runs Shell commands.", effect: Fuzzy),
    (id: "stats",      desktop: Tiling,    name: "Bar: run stats", price: 60,
     blurb: "Runs, exits, flatlines and best haul on the bar.",       effect: Stats),
    (id: "clock",      desktop: Workbench, name: "Clock & bank",   price: 50,
     blurb: "An uptime clock and your bank on the title bar.",        effect: Clock),
    (id: "pattern",    desktop: Workbench, name: "Backdrop pattern", price: 40,
     blurb: "A dithered backdrop, like every 1.3 desktop ever.",      effect: Pattern),
    (id: "liza-clock", desktop: Liza,      name: "Alarm Clock",    price: 40,
     blurb: "The time in the menu bar. Never miss a 4am run.",        effect: Clock),
    (id: "calculator", desktop: Liza,      name: "Calculator",     price: 60,
     blurb: "A desk accessory: bank, next upgrade, and how hot your numbers run.", effect: Calculator),
    (id: "liza-pattern", desktop: Liza,    name: "Desktop pattern", price: 30,
     blurb: "Bricks instead of the factory grey. Make it yours.",     effect: Pattern),
    (id: "multifinder", desktop: Liza,     name: "MultiFinder",    price: 90,
     blurb: "Keep every window open at once. Liza alone keeps three.", effect: MultiFinder),
]
