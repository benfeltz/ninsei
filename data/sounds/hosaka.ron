// The Hosaka's sound pack: a company workstation. Soft sines and triangles, office chimes,
// a polite "ding". Calm on purpose: even the flatline is a tidy shutdown tune.
// Same format as ono.ron (see there); every cue needs an entry.
//
// Music: what the office plays while you're on hold. Sine tunes over triangle basses, major
// seventh chords, a bossa or walking bass at a polite tempo, a tick at most for drums. As the
// trace runs high, the calm goes wrong while staying polite: a track drops out and the tune
// turns hollow, then the hold music hurries. Each tier keeps its chords on an 8-bar cycle.
(
    cues: [
        (cue: Hop,      notes: [(wave: Sine,     from: 1000, to: 1000, ms: 22,  vol: 0.12)]),
        (cue: IceRez,   notes: [(wave: Sine,     from: 660,  to: 660,  ms: 90,  vol: 0.20),
                                (wave: Sine,     from: 880,  to: 880,  ms: 120, vol: 0.20)]),
        (cue: Hit,      notes: [(wave: Noise,    from: 7000, to: 7000, ms: 12,  vol: 0.10),
                                (wave: Triangle, from: 880,  to: 860,  ms: 45,  vol: 0.22)]),
        (cue: Shield,   notes: [(wave: Sine,     from: 523,  to: 523,  ms: 60,  vol: 0.20),
                                (wave: Sine,     from: 659,  to: 659,  ms: 90,  vol: 0.20)]),
        (cue: Heal,     notes: [(wave: Sine,     from: 784,  to: 1046, ms: 140, vol: 0.20)]),
        (cue: Block,    notes: [(wave: Sine,     from: 300,  to: 240,  ms: 70,  vol: 0.22)]),
        (cue: Damage,   notes: [(wave: Triangle, from: 330,  to: 330,  ms: 120, vol: 0.28),
                                (wave: Triangle, from: 262,  to: 262,  ms: 170, vol: 0.28)]),
        (cue: Derez,    notes: [(wave: Sine,     from: 1046, to: 1046, ms: 60,  vol: 0.20),
                                (wave: Sine,     from: 1318, to: 1318, ms: 60,  vol: 0.20),
                                (wave: Sine,     from: 1568, to: 1568, ms: 150, vol: 0.20)]),
        (cue: Loot,     notes: [(wave: Triangle, from: 1568, to: 1568, ms: 40,  vol: 0.18),
                                (wave: Sine,     from: 2093, to: 2093, ms: 130, vol: 0.18)]),
        (cue: Download, notes: [(wave: Sine,     from: 700,  to: 1400, ms: 200, vol: 0.18)]),
        (cue: TraceUp,  notes: [(wave: Sine,     from: 1760, to: 1760, ms: 110, vol: 0.22)]),
        (cue: Encounter,notes: [(wave: Sine,     from: 988,  to: 988,  ms: 70,  vol: 0.20),
                                (wave: Sine,     from: 1319, to: 1319, ms: 70,  vol: 0.20),
                                (wave: Sine,     from: 1568, to: 1568, ms: 110, vol: 0.20)]),
        (cue: Flatline, notes: [(wave: Sine,     from: 660,  to: 660,  ms: 160, vol: 0.24),
                                (wave: Sine,     from: 495,  to: 495,  ms: 160, vol: 0.24),
                                (wave: Sine,     from: 330,  to: 330,  ms: 320, vol: 0.24)]),
        (cue: JackOut,  notes: [(wave: Sine,     from: 523,  to: 523,  ms: 110, vol: 0.20),
                                (wave: Sine,     from: 784,  to: 784,  ms: 110, vol: 0.20),
                                (wave: Sine,     from: 1046, to: 1046, ms: 110, vol: 0.20),
                                (wave: Sine,     from: 1568, to: 1568, ms: 200, vol: 0.20)]),
    ],
    music: [
        // Tier 1, the lobby: F major at 96 bpm. A sine tune over a bossa bass, with soft
