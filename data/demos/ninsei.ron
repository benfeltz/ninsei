    // The credits' place, and later the menu's.
    band: (y: 62, h: 40),
    credits: (style: "credits", gap: 4, hold: 0.85, pages: [
        ["ANOTHER FINE RELEASE", "FROM STRAYLIGHT"],
        ["NINSEI", "CRACKED ON THE FIRST DAY"],
        ["CRACK . INTRO . TUNE", "BY STRAYLIGHT"],
        ["ORIGINAL SUPPLIED BY", "A FRIEND AT THE VILLA"],
    ]),
    scroller: (style: "scroll", y: 176, passes: 1, amp: 5.0, wave: 160.0, cycles: 16,
        text: "STRAYLIGHT PRESENTS NINSEI ...   CRACKED ON THE FIRST DAY, AS ALWAYS ...   THE FLIGHT, THE ICE AND THE TUNE ARE OURS ...   NO DOCS, NO TRAINER: OUT THERE YOU ARE ON YOUR OWN ...   GREETINGS FLY OUT TO ",
        greetz: ["THE NIGHTMOTHS", "PHOSPHOR", "THE 2400 CLUB", "RAZORWIRE", "M0TH", "D1RGE", "KR4KEN", "THE NEON GUTTER", "DEAD SECTOR"],
        sep: " - "),

    // Four tracks in D minor at 120: a square lead over a saw arpeggio, a pumping triangle
    // bass and noise for the drums. Sixteen bars, thirty-two seconds, the loop's length.
    tune: (bpm: 120, tracks: [
        (wave: Square, vol: 0.12, pattern: "
            A4 - - - D5 - - - F5 - E5 - D5 - C5 -
            D5 - - - - - - - . . F4 - Bb4 - D5 -
            C5 - - - A4 - - - F4 - G4 - A4 - C5 -
            E5 - - - - - D5 - C5 - - - G4 - - -
            A4 - - - D5 - - - F5 - E5 - D5 - F5 -
            G5 - - - F5 - D5 - Bb4 - - - D5 - F5 -
            A5 - - - G5 - F5 - E5 - F5 - G5 - - -
            E5 - - - - - - - C5 - D5 - E5 - - -
            G5 - - - Bb5 - - - A5 - G5 - F5 - D5 -
            F5 - - - - - E5 - D5 - - - A4 - - -
            Bb4 - D5 - F5 - - - E5 - D5 - C5 - D5 -
            E5 - - - - - - - C#5 - E5 - A5 - - -
            D6 - - - A5 - - - F5 - - - D5 - - -
            F5 - - - D5 - - - Bb4 - - - D5 - F5 -
            G5 - - - E5 - - - C5 - D5 - E5 - G5 -
            A5 - - - - - - - E5 - C#5 - A4 - - -
