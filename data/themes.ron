// Colour themes. One theme colours everything: the desktop and your runs.
// Add one by adding an entry; Prefs, the `theme` command and the IDE's theme menu pick it up.
//
// colors: six "#rrggbb" values, darkest role to brightest:
//   bg      deepest background (text fields, the map; window shadows on the desktop)
//   panel   panel background (the desktop's screen colour)
//   faint   barely lit: borders, empty bar cells (icon fill on the desktop)
//   dim     secondary text
//   fg      normal text (window frames and title bars on the desktop)
//   bright  highlights (selections and accents on the desktop)
[
    (id: "amber",     label: "amber (P3)",
     colors: (bg: "#0b0700", panel: "#120c02", faint: "#3d2900", dim: "#a36e00", fg: "#ffb000", bright: "#ffdc8a")),
    (id: "green",     label: "green (P1)",
     colors: (bg: "#010802", panel: "#031006", faint: "#0b3d18", dim: "#1f9a42", fg: "#33ff66", bright: "#c2ffd2")),
    (id: "ice",       label: "ice (P4)",
     colors: (bg: "#00070b", panel: "#020e14", faint: "#0b3346", dim: "#2a8fb3", fg: "#5fe1ff", bright: "#d4f6ff")),
    (id: "plasma",    label: "plasma (gas)",
     colors: (bg: "#0a0200", panel: "#140402", faint: "#3d1005", dim: "#a8320f", fg: "#ff5a1f", bright: "#ffb08a")),
    (id: "workbench", label: "Workbench 1.3",
     colors: (bg: "#000022", panel: "#0055aa", faint: "#003a7a", dim: "#aaccff", fg: "#ffffff", bright: "#ff8800")),
    (id: "c64",       label: "Commodore 64",
     colors: (bg: "#2d2d70", panel: "#3b3b8f", faint: "#5a58b0", dim: "#8886d8", fg: "#a9a7ff", bright: "#dcdbff")),
    (id: "apple2",    label: "Apple ][",
     colors: (bg: "#000800", panel: "#001100", faint: "#0c3a14", dim: "#2aa63e", fg: "#4dff6b", bright: "#c4ffd0")),
    (id: "vga",       label: "IBM VGA",
     colors: (bg: "#000000", panel: "#0a0a0a", faint: "#3a3a3a", dim: "#808080", fg: "#c0c0c0", bright: "#ffffff")),
]
