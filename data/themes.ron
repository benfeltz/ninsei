// Colour themes. Add one by adding an entry: nothing else needs to change.
//
// run:      can colour a run's IDE (pick it in Prefs, the `theme` command, or the phosphor menu).
// desktop:  can colour the hub's Workbench (pick it in Prefs or with `desktop <id>`).
// colors:   six "#rrggbb" values, darkest role to brightest:
//   bg      deepest background (text fields, the map; window shadows on the desktop)
//   panel   panel background (the desktop's screen colour)
//   faint   barely lit: borders, empty bar cells (icon fill on the desktop)
//   dim     secondary text
//   fg      normal text (window frames and title bars on the desktop)
//   bright  highlights (selections and accents on the desktop)
[
    (id: "amber",     label: "amber (P3)",    run: true,  desktop: true,
     colors: (bg: "#0b0700", panel: "#120c02", faint: "#3d2900", dim: "#a36e00", fg: "#ffb000", bright: "#ffdc8a")),
    (id: "green",     label: "green (P1)",    run: true,  desktop: true,
     colors: (bg: "#010802", panel: "#031006", faint: "#0b3d18", dim: "#1f9a42", fg: "#33ff66", bright: "#c2ffd2")),
    (id: "ice",       label: "ice (P4)",      run: true,  desktop: true,
     colors: (bg: "#00070b", panel: "#020e14", faint: "#0b3346", dim: "#2a8fb3", fg: "#5fe1ff", bright: "#d4f6ff")),
    (id: "plasma",    label: "plasma (gas)",  run: true,  desktop: true,
     colors: (bg: "#0a0200", panel: "#140402", faint: "#3d1005", dim: "#a8320f", fg: "#ff5a1f", bright: "#ffb08a")),
    (id: "workbench", label: "Workbench 1.3", run: false, desktop: true,
     colors: (bg: "#000022", panel: "#0055aa", faint: "#0055aa", dim: "#aaccff", fg: "#ffffff", bright: "#ff8800")),
]
